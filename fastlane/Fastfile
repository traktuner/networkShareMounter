# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

require 'tempfile'
skip_docs

# Build number offset: CI_PIPELINE_IID started at 214, last manual build was 360.
# Offset ensures CI build numbers are always > last manual build number.
BUILD_NUMBER_OFFSET = 160

# git url of match
@match_git_url = ENV["MATCH_GIT_URL"]

default_platform(:mac)

platform :mac do
  desc "Description of what the lane does"
  lane :custom_lane do
    # add actions here: https://docs.fastlane.tools/actions
  end
end

# ─────────────────────────────────────────────────────────────
# SINGLE SOURCE OF TRUTH: Build Number
# ─────────────────────────────────────────────────────────────
def resolve_build_number
  if is_ci && ENV["CI_PIPELINE_IID"]
    offset = BUILD_NUMBER_OFFSET
    new_build = (ENV["CI_PIPELINE_IID"].to_i + offset).to_s
    UI.message("🔢 CI pipeline #{ENV["CI_PIPELINE_IID"]} + offset #{offset} = build #{new_build}")
  else
    # Lokal normal hochzählen und den neuen Wert abfangen
    new_build = increment_build_number(
      xcodeproj: "networkShareMounter.xcodeproj"
    ).to_s
    UI.message("🔢 Locally incremented build number to: #{new_build}")
  end

  # Build Number konsistent im Projekt verankern
  increment_build_number(
    build_number: new_build,
    xcodeproj: "networkShareMounter.xcodeproj"
  )

  UI.success("✅ Build number safely locked to: #{new_build}")
  new_build
end

lane :setupCI do
  desc "Setup the keychain and match to work with CI"
  setup_ci
end

lane :getbundleid do
  desc "gets bundleid from the xcode project files"
  get_product_bundle_id(project_filepath: 'networkShareMounter.xcodeproj', scheme: 'NetworkShareMounter')
end

lane :getappversion do
  desc "gets the version of the app. It first looks in the plist and then for '$(MARKETING_VERSION)'"
  get_version_number(xcodeproj: "networkShareMounter.xcodeproj", target: "Network Share Mounter")  
end

lane :getlatestag do
  desc "gets the latest git tag. This tag is used to set the version number of the package"
  tags = git_tags(limit: 1)
  tags.join()
end

lane :verify_tag_version do
  desc "aborts the build if the git tag's version doesn't match MARKETING_VERSION"
  commit_tag = ENV["CI_COMMIT_TAG"]
  next unless is_ci && commit_tag

  tag_version = commit_tag[/\d+\.\d+\.\d+/]
  project_version = getappversion

  if tag_version.nil?
    UI.user_error!("❌ Could not extract a version (x.y.z) from tag '#{commit_tag}'.")
  elsif tag_version != project_version
    UI.user_error!("❌ Version mismatch: tag '#{commit_tag}' implies version #{tag_version}, but MARKETING_VERSION in the Xcode project is #{project_version}. Bump MARKETING_VERSION (and merge!) before tagging.")
  else
    UI.success("✅ Tag version (#{tag_version}) matches MARKETING_VERSION (#{project_version})")
  end
end

lane :sentryUpload do
  desc "send dSYM and maybe other data to our sentry instance"
  sentry_debug_files_upload(
    project_slug: "network-share-mounter",
  )
end

lane :sync_certificates do
  desc "Sync certificates using match"
  # Setup App Store Connect API Key
  app_store_connect_api_key(
    is_key_content_base64: true
  )
  
  # Aufruf 1: developer_id + mac_installer_distribution → funktioniert mit API Key
  match(
    type: "developer_id",
    readonly: is_ci,
    platform: "macos",
    app_identifier: 'de.fau.rrze.NetworkShareMounter',
    additional_cert_types: ["mac_installer_distribution"]
  )
  
  # Aufruf 2: developer_id_installer → API Key unterstützt diesen Typ NICHT.
  # Daher: immer readonly + skip_certificate_matching, nur aus dem Match-Repo installieren.
  match(
    type: "developer_id",
    readonly: true,
    platform: "macos",
    app_identifier: 'de.fau.rrze.NetworkShareMounter',
    additional_cert_types: ["developer_id_installer"],
    skip_provisioning_profiles: true,   # kein Profil nötig, nur das Zertifikat
    skip_certificate_matching: true     # NICHT gegen Apple Developer Portal prüfen!
  )
end


lane :commonTasks do
  desc "perform some common build tasks"
  id = getbundleid
  tag = getlatestag

  verify_tag_version

  # Setup CI if running in CI environment
  setupCI if is_ci
  
  # Run SwiftLint
  swiftlint(
    mode: :lint,
    output_file: "swiftlint.result",
    config_file: ".swiftlint-ci.yml",
    files: [
      "Network Share Mounter/preferences/config.swift",
    ],
    raise_if_swiftlint_error: true,
    ignore_exit_status: true
  )
  
  # Sync certificates
  sync_certificates
  
  # Build the app
  gym(
    scheme: "networkShareMounter",
    output_directory: "build/",
    export_method: "developer-id",
    installer_cert_name: "Universitaet Erlangen-Nuernberg RRZE (C8F68RFW4L)"
  )
end

lane :build do
  begin
    commonTasks
  end
end

lane :create_package do |options|
  appversion = getappversion
  build_type = options[:type] || ""
  suffix = build_type.empty? ? "" : "#{build_type}-"
  
  desc "Create DMG image"
  dmg(
    path: "build/Network Share Mounter.app",
    output_path: "build/NetworkShareMounter-#{suffix}#{appversion}.dmg",
    volume_name: "NetworkShareMounter#{build_type.empty? ? "" : "-#{build_type}"}",
    size: 15
  )
  
  desc "creating .pkg file"
  signing_id = ENV["SIGNING_ID"]
  output = sh("productbuild", 
            "--sign",  "#{signing_id}", 
            "--scripts", "../pkgscripts", 
            "--version", "#{appversion}", 
            "--component", "../build/Network Share Mounter.app", 
            "/Applications", 
            "../build/NetworkShareMounter-#{suffix}#{appversion}.pkg")

  desc "Notarize dmg"
  notarize(
    package: "build/NetworkShareMounter-#{suffix}#{appversion}.dmg", 
    bundle_id: "de.fau.rrze.NetworkShareMounter", 
    username: "rrze-apple-entwickler@fau.de"
  )
  
  desc "Notarize pkg"
  notarize(
    package: "build/NetworkShareMounter-#{suffix}#{appversion}.pkg", 
    bundle_id: "de.fau.rrze.NetworkShareMounter", 
    username: "rrze-apple-entwickler@fau.de"
  )
end

# ─────────────────────────────────────────────────────────────
# Build Lanes
# ─────────────────────────────────────────────────────────────

lane :testbuild do
  begin
    desc "Resolve and set consistent build number"
    resolve_build_number
    
    build
    create_package(type: "Test")
    sparkle(type: "Test")
  rescue => exception
    on_error(exception)
  ensure
    restore_default_keychain
  end
end

lane :alpha do
  begin
    desc "Resolve and set consistent build number"
    resolve_build_number
    
    build
    create_package(type: "Alpha")
    sentryUpload
  rescue => exception
    on_error(exception)
  ensure
    restore_default_keychain
  end
end

lane :beta do
  begin
    desc "Resolve and set consistent build number"
    resolve_build_number
    
    build
    create_package(type: "Beta")
    sentryUpload
  rescue => exception
    on_error(exception)
  ensure
    restore_default_keychain
  end
end

lane :release do
  begin
    desc "Resolve and set consistent build number"
    resolve_build_number
    
    build
    create_package
    sentryUpload
  rescue => exception
    on_error(exception)
  ensure
    restore_default_keychain
  end
end

# generates the command-line networkShareMounter app
lane :runbuild do
  id = getbundleid
  tag = getlatestag
  signing_id = ENV["SIGNING_ID"]
  output = sh("../build.sh", "#{id}", "#{tag}", "#{signing_id}")
end

# generates Sparkle appcast file
lane :sparkle do |options|
  build_type = options[:type] || "release"

  SKIP_SPARKLE_FOR = ["alpha", "test"].freeze
  if SKIP_SPARKLE_FOR.include?(build_type.downcase)
    UI.important("⏭️  Sparkle appcast wird für '#{build_type}'-Builds übersprungen.")
    next
  end

  UI.message("🚀 Starting sparkle lane for type: #{build_type}")

  appversion = getappversion
  workspace = "../build/sparkle_workspace"
  sh("rm -rf #{workspace} ; mkdir -p #{workspace}")

  # DMG in Workspace kopieren (Name ohne Build-Typ-Suffix für generate_appcast)
  dmg_suffix = build_type.downcase == "release" ? "" : "#{build_type}-"
  sh("cp ../build/NetworkShareMounter-#{dmg_suffix}#{appversion}.dmg #{workspace}/NetworkShareMounter-#{appversion}.dmg")

  # Live-Appcast holen (Fehler hier ist nicht fatal)
  begin
    sh("curl -f -s -o #{workspace}/nsm-appcast https://www.nsm.faumac.rrze.de/nsm-appcast")
    UI.success("✅ Got live appcast file.")
  rescue
    UI.important("⚠️ Could not load live appcast file – will create new one.")
  end

  # Existenz-Check
  generate_appcast = "/opt/sparkle-tools/bin/generate_appcast"
  UI.user_error!("❌ generate_appcast nicht gefunden: #{generate_appcast}") unless File.executable?(generate_appcast)

  commit_tag = ENV["CI_COMMIT_TAG"] || "#{build_type}-#{appversion}"

  begin
    if ENV['SPARKLE_PRIVATE_KEY'] && !ENV['SPARKLE_PRIVATE_KEY'].empty?
      Tempfile.create('sparkle_key') do |temp_key_file|
        temp_key_file.write(ENV['SPARKLE_PRIVATE_KEY'])
        temp_key_file.close
        sh(
          generate_appcast,
          "--ed-key-file", temp_key_file.path,
          "--download-url-prefix", "https://gitlab.rrze.fau.de/api/v4/projects/506/packages/generic/networksharemounter/#{commit_tag}/",
          "--full-release-notes-url", "https://gitlab.rrze.fau.de/faumac/networkShareMounter/-/raw/dev/CHANGELOG",
          workspace
        )
      end
      UI.success("✅ Generated appcast file with signatures.")
    else
      UI.user_error!("🔴 SPARKLE_PRIVATE_KEY ist nicht gesetzt – Abbruch!")
    end
  rescue => ex
    UI.user_error!("🔴 Appcast generation failed: #{ex.message}")
  end

  sh("mkdir -p ../nsm-website/static/")
  sh("cp #{workspace}/nsm-appcast ../nsm-website/static/nsm-appcast")
  sh("scp #{workspace}/nsm-appcast kima.rrze.uni-erlangen.de:/proj/websource/docs/RRZEWeb/www.faumac.rrze.uni-erlangen.de/websource/apps/")
end


def on_error(exception)
  UI.error("An error occurred: #{exception}")
  raise exception
end

def restore_default_keychain
  if is_ci
    begin
      sh("security delete-keychain fastlane_tmp_keychain-db")
      sh("security default-keychain -s login.keychain-db")
      UI.success("✅ Default keychain restored")
    rescue => e
      UI.error("⚠️  Failed to restore default keychain: #{e}")
    end
  end
end
