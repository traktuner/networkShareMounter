    "Your Active Directory password expires %@. Please change it now to avoid being locked out." : {
      "comment" : "Body text - password expiring soon, change action available",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Active Directory-Passwort läuft %@ ab. Bitte ändern Sie es jetzt, um eine Sperrung zu vermeiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Active Directory password expires %@. Please change it now to avoid being locked out."
          }
        },
